{
  "name": "moyai",
  "version": "0.0.0",
  "private": true,
  "description": "保全の履歴を公の設備・機器のリスト × 作業の属性にそろえ、星取表で似た施設と比べる",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "npm": ">=11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p services/ledger-intake/tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "e2e": "playwright test",
    "check-publish": "node scripts/check-publish.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "demo-ring": "node scripts/demo-ring/build.mjs",
    "scenario:b2": "vitest run tests/unit/scenario-b2-intake.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.1",
    "@fontsource/krona-one": "5.3.0",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "ssf": "0.11.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "bin": {
    "moyai": "dist/cli.js"
  },
  "overrides": {
    "@napi-rs/canvas": "1.0.11"
  }
}
