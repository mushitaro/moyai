{
  "name": "moyai-factory",
  "description": "工場の仕事のサンドボックス。github.com（鍵なしの clone）とパッケージの置き場だけに届く",
  "config": {
    "type": "cloud",
    "networking": {
      "type": "limited",
      "allow_package_managers": true,
      "allow_mcp_servers": false,
      "allowed_hosts": ["github.com", "codeload.github.com"]
    }
  }
}
